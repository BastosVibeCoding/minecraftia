{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsc -p tsconfig.json --noEmit 1>&2 || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
