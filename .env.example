# Copier en .env et remplir. Ce fichier est le SEUL endroit où vivent les secrets.

# --- Serveur Minecraft ---
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Alex
# genre grammatical du personnage : feminine | masculine
BOT_GENDER=feminine
# voix de synthèse du bot (Edge TTS), ex. fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural, fr-FR-EloiseNeural
BOT_VOICE=fr-FR-DeniseNeural
MC_VERSION=1.21

# Pseudo du joueur que le bot suit et dont il apprend
FOLLOW_PLAYER=JuicyBerries1993

# mirror (défaut) : le bot devient comme le joueur. complement : non implémenté.
STRATEGY=mirror

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_STRONG=anthropic/claude-sonnet-5.5
# Budget quotidien en dollars : au-delà, le bot retombe sur suivi + réflexes
DAILY_BUDGET_USD=1.00

# --- Divers ---
LOG_LEVEL=info
LOG_PRETTY=false
DATA_DIR=data

# --- Télémétrie Easy LLM (mod serveur) ---
TELEMETRY_PORT=7891
# Fichier JSONL de capture des messages bruts (laisser vide en temps normal)
TELEMETRY_CAPTURE=

# --- Chaîne de fournisseurs LLM (facultatif ; sinon OpenRouter seul) ---
# Essayés dans l'ordre ; un fournisseur saturé, à court de quota ou en erreur passe la main au suivant.
# LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3-super-120b-a12b:free,ollama:alex-7b
GEMINI_API_KEY=
GROQ_API_KEY=
# Ollama sur la machine hôte (depuis le conteneur du bot)
OLLAMA_URL=http://host.docker.internal:11434/v1
