{
  "name": "minecraftia",
  "version": "0.1.0",
  "description": "Compagnon IA Minecraft dont le rôle émerge du style de jeu de son joueur",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BastosVibeCoding/minecraftia.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/BastosVibeCoding/minecraftia/issues"
  },
  "homepage": "https://github.com/BastosVibeCoding/minecraftia#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "pino": "^10.4.0",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
